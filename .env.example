# ── 방법 0: API 키 없이 무료 오픈소스 LLM (Qwen2.5) 직접 실행 ── GPU 권장, pip install transformers accelerate torch
# LLM_PROVIDER=local
# LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct

# ── 방법 1: Gemini (무료) ── https://aistudio.google.com 에서 API 키 발급
# OPENAI_API_KEY=AIza...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-2

# ── 방법 2: OpenAI (유료) ── https://platform.openai.com 에서 API 키 발급
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# USE_EMBEDDINGS=0    # 임베딩 끄고 TF-IDF만 사용
